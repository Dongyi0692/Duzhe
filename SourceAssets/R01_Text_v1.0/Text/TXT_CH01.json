      "description": "镜腿上缠着一圈细线，镜片擦得很干净。"
    },
    {
      "itemId": "IT02_Cane",
      "displayName": "拐杖",
      "description": "一根弯把木拐杖，握住的地方光滑温润。"
    }
  ]
}
